# Deployed to /opt/apps/ai-career/.env — copy this file there and fill it in.
# Read by BOTH the api and gateway containers (compose `env_file`), and by
# compose itself for the image names and tags.

# --- Image coordinates (used by compose.yml) ---
REGISTRY=asia-southeast1-docker.pkg.dev
PROJECT_ID=
REPOSITORY=backend-images

# Rewritten by the Jenkins Deploy stage of each pipeline. Leave as latest.
API_IMAGE_TAG=latest
GATEWAY_IMAGE_TAG=latest

# --- Database (the db service reads these too) ---
PGDATABASE=ai_career
DB_USER=
DB_PASS=
# PGHOST/PGPORT are set by compose (db:5432) — do not put them here.

# --- Keycloak (backend: resource server) ---
KEYCLOAK_ISSUER_URI=
KEYCLOAK_JWK_SET_URI=
KEYCLOAK_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- Keycloak (gateway: OAuth2 client / BFF) ---
KEYCLOAK_BFF_CLIENT_ID=ai-career-bff
KEYCLOAK_BFF_CLIENT_SECRET=

# --- Gateway upstreams ---
# BACKEND_URI is set by compose (http://api:8080) — do not put it here.
FRONTEND_URI=
ADMIN_FRONTEND_URI=

# --- Gemini ---
# Both are now bootstrap defaults only: SUPER_ADMIN can override the key, the
# model, the per-task models and the tuning from the admin console, and those
# take effect without a restart. Leaving GEMINI_API_KEY blank is allowed — the
# server starts, and AI features report that no key is set until one is saved.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Encrypts secrets saved from the admin console (currently the provider API
# key). Without it the console refuses to store a key rather than writing it to
# the database in the clear. Must be a base64-encoded 32-byte value, and must
# stay the same across restarts or saved secrets become unreadable:
#   openssl rand -base64 32
AI_SETTINGS_ENCRYPTION_KEY=

# --- MinIO ---
MINIO_ENDPOINT=
MINIO_BUCKET=ai-career
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- App ---
SERVER_URL=
# Shared secret Vapi presents on its webhook; unset disables the webhook.
VAPI_WEBHOOK_SECRET=
